# Kopioi tämä tiedosto nimelle .env.local ja täytä arvot
# Supabase-projektin asetuksista (Settings → API).
# Älä koskaan liitä avaimia chattiin tai git-repositorioon.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Palvelinavain vain myöhempiä ylläpito- ja agenttitoimintoja varten.
# Älä lisää NEXT_PUBLIC_-etuliitettä.
# SUPABASE_SERVICE_ROLE_KEY=
