# Kopioi tämä tiedosto nimelle .env.local ja täytä arvot
# Supabase-projektin asetuksista (Settings → API).
# Älä koskaan liitä avaimia chattiin tai git-repositorioon.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Maanmittauslaitoksen avoin karttakuva ja geokoodaus (sama OmaTili-avain).
# NEXT_PUBLIC_MML_API_AVAIN=
# Valinnainen palvelin-alias: MML_API_AVAIN=

# Palvelinavain vain ylläpidon hyväksyntään. Älä lisää NEXT_PUBLIC_-etuliitettä.
SUPABASE_SERVICE_ROLE_KEY=
